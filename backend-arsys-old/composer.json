{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.1.3",
        "apereo/phpcas": "1.4.0",
        "asdh/laravel-flatpickr": "^2.0",
        "atomescrochus/laravel-string-similarities": "^2.1",
        "barryvdh/laravel-dompdf": "^2.0",
        "cybercog/laravel-optimus": "^3.8",
        "fruitcake/php-cors": "^1.4",
        "guzzlehttp/guzzle": "^7.2",
        "highsolutions/laravel-searchy": "^11.0",
        "hisorange/browser-detect": "^4.5",
        "irazasyed/telegram-bot-sdk": "^3.13",
        "jantinnerezo/livewire-alert": "^2.2",
        "jenssegers/agent": "^2.6",
        "jeroennoten/laravel-adminlte": "^3.8.1",
        "laravel/framework": "^9.2",
        "laravel/sanctum": "^3.3",
        "laravel/socialite": "^5.11",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^3.4",
        "livewire/livewire": "^2.12",
        "maatwebsite/excel": "^3.1",
        "rappasoft/laravel-livewire-tables": "^2.14",
        "spatie/laravel-permission": "^6.24",
        "subfission/cas": "4.2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]

    },

    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
